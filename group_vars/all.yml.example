---
# Override default trusted subnets for your specific homelab environment
cis_trusted_subnets:
  - "192.168.1.0/24"
  - "10.0.0.0/16"

# Optional local overrides for SSH or firewall ports if needed
# cis_sshd_permit_root_login: "no"
