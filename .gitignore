# Local inventory & secrets overrides
inventory.local.ini
*.local.yml
.vault_pass
.vault-pass
group_vars/all.yml

# Ansible execution artifacts
*.retry
*.log
.ansible/
.ansible-lint

# IDE & OS clutter
.vscode/
.idea/
.DS_Store
__pycache__/
*.pyc
